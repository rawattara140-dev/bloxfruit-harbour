# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file. It is already listed in .gitignore.

# Server
PORT=3000
NODE_ENV=development
# Public address of the site (no trailing slash). Used for the Roblox redirect URL.
BASE_URL=http://localhost:3000

# Database (SQLite file, created automatically on first start)
DATABASE_PATH=./data/harbour.db

# Comma-separated usernames that get admin rights (edit values, review reports).
# Register these accounts yourself right after the first start.
ADMIN_USERNAMES=

# Set to the number of reverse proxies in front of the app (for example 1 on
# Render, Railway, Fly.io or behind nginx) so rate limiting sees real IPs.
# Leave as 0 when running locally.
TRUST_PROXY=0

# Optional: "Connect Roblox account" (official Roblox OAuth 2.0 sign-in).
# Create an OAuth 2.0 app at https://create.roblox.com/dashboard/credentials
# Scopes needed: openid profile
# The redirect URL registered there must match ROBLOX_REDIRECT_URI exactly.
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_REDIRECT_URI=http://localhost:3000/api/auth/roblox/callback

# ---- Support / moderator account -------------------------------------------------------------
# Comma-separated Google emails that get the Support role. The role is only granted after that person
# connects Google in Settings AND Google confirms the email is verified, so typing the address at sign-up
# does nothing. No Gmail password is ever used or stored. Leave empty (SUPPORT_EMAILS=) to switch it off.
SUPPORT_EMAILS=thegodness825@gmail.com

# ---- Google sign-in (OAuth 2.0), needed to verify the Support account ---------------------------
# Create an OAuth client (type "Web application") at https://console.cloud.google.com/apis/credentials
# and add GOOGLE_REDIRECT_URI to its "Authorized redirect URIs". Scopes used: openid, email, profile.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---- Store payments --------------------------------------------------------------------------------
# test   = no real money; buyers press "Simulate payment". Automatically disabled when NODE_ENV=production
#          (unless ALLOW_TEST_PAYMENTS=1, which you should not set on a live site).
# manual = no credentials needed; orders are reserved and staff mark them paid once money has arrived.
# A Nepal provider (eSewa, Khalti, Fonepay) can be added later in lib/payments.js; its secrets go here, server-side only.
PAYMENT_PROVIDER=test
ALLOW_TEST_PAYMENTS=0
# Shown to buyers when PAYMENT_PROVIDER=manual (for example your eSewa / bank details).
MANUAL_PAYMENT_INSTRUCTIONS=

# ---- Fruit images -------------------------------------------------------------------------------------
# Pictures are looked up once through the public Blox Fruits wiki API, then cached in data/img-cache and the
# database. Set to 0 to skip the background lookup at startup (pictures are then fetched on first view).
IMAGE_WARMUP=1
